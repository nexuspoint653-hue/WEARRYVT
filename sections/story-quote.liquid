{% render 'section-style', s: section %}
{%- if section.settings.visible -%}
<section class="st-quote">
  <div class="wrap">
    {%- if section.settings.quote != blank -%}<blockquote>{{ section.settings.quote }}</blockquote>{%- endif -%}
    {%- if section.settings.byline != blank -%}<span class="st-by">{{ section.settings.byline }}</span>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Story pull quote",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "\u201cA tee should outlast the season you bought it in. Everything else about this one follows from that.\u201d"
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline",
      "default": "RYVT \u00b7 Metro Detroit"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Story pull quote"
    }
  ]
}
{% endschema %}
