  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero + stat band",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "figure": "8.2 oz",
            "label": "The cloth",
            "note": "Heavyweight cotton, garment-dyed, washed before it is cut."
