{% render 'section-style', s: section %}
{%- if section.settings.show_film and section.settings.film_label != blank -%}
<a class="to-film" href="{{ section.settings.film_link | default: '/' }}"><i aria-hidden="true"></i>{{ section.settings.film_label }}{% if section.settings.film_note != blank %} <span>{{ section.settings.film_note }}</span>{% endif %}</a>
{%- endif -%}
{%- if section.settings.show_scrim -%}
<div class="srch-scrim" data-scrim="" hidden=""></div>
{%- endif -%}
{% schema %}
{
  "name": "Film strip",
  "settings": [
    {
      "type": "header",
      "content": "Back to the film"
    },
    {
      "type": "checkbox",
      "id": "show_film",
      "label": "Show the film link",
      "default": true
    },
    {
      "type": "text",
      "id": "film_label",
      "label": "Label",
      "default": "The RYVT film"
    },
    {
      "type": "text",
      "id": "film_note",
      "label": "Note",
      "default": "\u2014 back to the landing"
    },
    {
      "type": "url",
      "id": "film_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Search scrim"
    },
    {
      "type": "checkbox",
      "id": "show_scrim",
      "label": "Show the search scrim",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Film strip"
    }
  ]
}
{% endschema %}
