      "default": "&copy; 2026 RYVT &middot; Metro Detroit, Michigan"
    },
    {
      "type": "text",
      "id": "socials",
      "label": "Social line",
      "default": "Instagram &middot; TikTok"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
