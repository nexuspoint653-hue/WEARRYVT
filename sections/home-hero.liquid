{% render 'section-style', s: section %}
{%- unless section.settings.visible == false -%}
{%- if section.settings.bleed -%}
<style>
  #shopify-section-{{ section.id }}{position:relative;z-index:0}
  #shopify-section-{{ section.id }} .hero{overflow:visible}
  #shopify-section-{{ section.id }} .hero .plate{bottom:-{{ section.settings.bleed_height }}px;pointer-events:none}
  #shopify-section-{{ section.id }} .hero-in{position:relative;z-index:1}
</style>
{%- endif -%}
<section class="hero">
  {%- if section.settings.image != blank -%}
  <span class="plate" style="background-image:url({{ section.settings.image | image_url: width: 2400 }});background-size:cover;background-position:center"></span>
  {%- else -%}
  <span class="plate ph {{ section.settings.plate_style }}"></span>
  {%- endif -%}
  <div class="wrap hero-in">
    {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
    <div class="cta-row">
      {%- if section.settings.btn1_label != blank -%}<a class="btn btn-solid" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
      {%- if section.settings.btn2_label != blank -%}<a class="btn btn-ghost" href="{{ section.settings.btn2_link | default: '/pages/the-renaissance-tee' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
{%- endunless -%}
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Metro Detroit · Est. 2024"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (line breaks kept)",
      "default": "Detroit,\nOn Your Back."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Heavyweight cotton cut for people who actually move. Made in small runs, finished by hand, and named for the streets it came from."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "plate_style",
      "label": "Placeholder tone (used when no image)",
      "default": "dark",
      "options": [
        {
          "value": "",
          "label": "Light"
        },
        {
          "value": "alt",
          "label": "Mid"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary label",
      "default": "One tee, four ways"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Image bleed"
    },
    {
      "type": "checkbox",
      "id": "bleed",
      "label": "Continue the image into the section below",
      "default": false,
      "info": "The band underneath needs 'Let the hero image show through' switched on."
    },
    {
      "type": "range",
      "id": "bleed_height",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "How far it bleeds",
      "default": 240
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
