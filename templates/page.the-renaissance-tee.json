          "type": "detail",
          "settings": {
            "title": "Ribbed collar, double-needle",
            "text": "The first thing to fail on a cheap tee, reinforced here so it holds its round.",
            "spec_value": "1\u00d71 rib",
            "spec_note": "Still round in year four"
          }
        },
        "detail_b2": {
          "type": "detail",
          "settings": {
            "title": "Garment-dyed, then washed twice",
            "text": "The shrink happens before you own it, not in your dryer.",
            "spec_value": "Under 1% shrink",
            "spec_note": "Measured after ten washes"
          }
        },
        "detail_b3": {
          "type": "detail",
          "settings": {
            "title": "Flat side seams",
            "text": "Nothing to twist after a wash, nothing to bulk under a belt.",
            "spec_value": "No twist",
            "spec_note": "Panels cut on the same grain"
          }
        }
      },
