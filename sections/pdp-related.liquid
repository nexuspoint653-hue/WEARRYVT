{% render 'section-style', s: section %}
{%- unless section.settings.visible == false -%}
{%- comment -%}
    Three ways to fill this grid, in order: Shopify's own recommendations when
    the merchant asks for them and we are on a product page, then a picked
    collection, then - if neither has anything - the original JS-driven
    [data-pairs] container, untouched, so the demo still paints itself.
{%- endcomment -%}
{%- liquid
  assign rel_products = null
  assign rec_pending = false
  assign rel_count = section.settings.count | default: 4 | plus: 0
  if section.settings.use_recommendations and product != blank
    if recommendations.performed
      if recommendations.products_count > 0
        assign rel_products = recommendations.products
      endif
    else
      assign rec_pending = true
    endif
  endif
  if rel_products == null
    assign rel_coll = collections[section.settings.collection]
    assign coll_size = rel_coll.products.size | plus: 0
    if coll_size > 0
      assign rel_products = rel_coll.products
    endif
  endif
  assign has_products = false
  if rel_products != null and rel_count > 0
    assign has_products = true
  endif
  assign gcols = section.settings.columns | default: 'default'
  assign gcols_n = gcols | plus: 0
  assign gcols_m = gcols_n
  if gcols_m > 3
    assign gcols_m = 3
  endif
  assign gcols_s = gcols_n
  if gcols_s > 2
    assign gcols_s = 2
  endif
-%}
{%- if section.settings.spa_view != blank -%}<div data-view="{{ section.settings.spa_view }}"{% if section.settings.spa_open %} class="on"{% endif %}>{%- endif -%}
<section class="sec wrap"{% if rec_pending %} data-recs-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;limit={{ rel_count }}&amp;product_id={{ product.id }}"{% endif %}>
  <div class="sec-h">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 style="margin-top:8px">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
  </div>
{%- if has_products %}
{%- if gcols != 'default' %}
  <style>#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_n }},1fr)}@media(max-width:1000px){#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_m }},1fr)}}@media(max-width:749px){#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_s }},1fr)}}</style>
{%- endif %}
  <div class="grid">
    {%- for card_product in rel_products limit: rel_count %}
    {% render 'product-card', product: card_product, index: forloop.index, tone_index: forloop.index0, ratio: section.settings.card_ratio, hover: section.settings.card_hover, badge_mode: section.settings.card_badge, swatch_mode: section.settings.card_swatches, colour_mode: section.settings.card_colour %}
    {%- endfor %}
  </div>
{%- else %}
  <div class="grid" data-pairs=""></div>
{%- endif %}
</section>
{%- if section.settings.spa_view != blank -%}</div>{%- endif -%}
{%- endunless -%}
{% schema %}
{
