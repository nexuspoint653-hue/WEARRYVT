{% render 'section-style', s: section %}
{%- unless section.settings.visible == false -%}
<section class="st-detail">
  <div class="st-detail-media">
    {%- if section.settings.image_1 != blank -%}<span class="ph" style="background-image:url({{ section.settings.image_1 | image_url: width: 1600 }});background-size:cover;background-position:center"></span>{%- else -%}<span class="ph {{ section.settings.tone_1 }}"></span>{%- endif -%}
    {%- if section.settings.image_2 != blank -%}<span class="ph" style="background-image:url({{ section.settings.image_2 | image_url: width: 1600 }});background-size:cover;background-position:center"></span>{%- else -%}<span class="ph {{ section.settings.tone_2 }}"></span>{%- endif -%}
  </div>
  <div class="st-detail-txt">
    {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading }}</h3>{%- endif -%}
    <div class="st-list">
      {%- for block in section.blocks -%}
      <div data-detail="" {{ block.shopify_attributes }}>
        <b>{{ block.settings.title }}</b>
        <span>{{ block.settings.text }}</span>
        {%- if block.settings.spec_value != blank or block.settings.spec_note != blank -%}<span aria-hidden="true" class="st-spec-out"><i>{{ block.settings.spec_value }}</i>{{ block.settings.spec_note }}</span>{%- endif -%}
      </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.btn_label != blank -%}
    <a class="btn btn-dark" data-product="renaissance" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label }}</a>
    {%- endif -%}
  </div>
</section>
{%- endunless -%}
{% schema %}
{
