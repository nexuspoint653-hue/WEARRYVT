        },
        {
          "type": "strip",
          "settings": {
            "bold": "",
            "text": "Shop all 8 styles \u2192",
            "link": "/collections/all"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "Heavyweight tees",
            "term": "heavyweight"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "Tank tops",
            "term": "tank"
          }
        },
        {
          "type": "term",
          "settings": {
