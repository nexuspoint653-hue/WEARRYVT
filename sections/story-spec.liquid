{% render 'section-style', s: section %}
{%- if section.settings.visible -%}
<div class="st-spec">
  <div class="wrap">
    <dl>
      {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}><dt>{{ block.settings.term }}</dt><dd>{{ block.settings.value }}</dd></div>
      {%- endfor -%}
    </dl>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Story spec bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Term",
          "default": "Weight"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "8.2 oz"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Story spec bar",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "term": "Weight",
            "value": "8.2 oz"
          }
        },
        {
          "type": "spec",
          "settings": {
            "term": "Cotton",
            "value": "Garment-dyed"
          }
        },
        {
          "type": "spec",
          "settings": {
            "term": "Body",
            "value": "Boxy, set shoulder"
          }
        },
        {
          "type": "spec",
          "settings": {
            "term": "Sizes",
            "value": "XS \u2013 XXL"
          }
        },
        {
          "type": "spec",
          "settings": {
            "term": "Made",
            "value": "Metro Detroit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
