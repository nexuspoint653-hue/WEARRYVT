{% render 'section-style', s: section %}
{%- unless section.settings.visible == false -%}
{%- comment -%}
    Real products when the merchant has pointed this rail at a collection.
    Nothing picked, or nothing in it, and the original JS-driven container is
    rendered instead - untouched, data hook and all - so the demo rail still
    paints itself exactly as it does today.
{%- endcomment -%}
{%- liquid
  assign rail_coll = collections[section.settings.collection]
  assign rail_products = rail_coll.products
  assign rail_size = rail_products.size | plus: 0
  assign rail_count = section.settings.count | default: 4 | plus: 0
  assign has_products = false
  if rail_size > 0 and rail_count > 0
    assign has_products = true
  endif
  assign gcols = section.settings.columns | default: 'default'
  assign gcols_n = gcols | plus: 0
  assign gcols_m = gcols_n
  if gcols_m > 3
    assign gcols_m = 3
  endif
  assign gcols_s = gcols_n
  if gcols_s > 2
    assign gcols_s = 2
  endif
-%}
<section class="sec wrap"{% if section.settings.tight %} style="padding-top:0"{% endif %}>
  <div class="sec-h">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 style="margin-top:8px">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- if section.settings.more_label != blank -%}
    <a class="more" href="{{ section.settings.more_link | default: routes.all_products_collection_url }}">{{ section.settings.more_label }}</a>
    {%- endif -%}
  </div>
{%- if has_products %}
{%- if gcols != 'default' %}
  <style>#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_n }},1fr)}@media(max-width:1000px){#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_m }},1fr)}}@media(max-width:749px){#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_s }},1fr)}}</style>
{%- endif %}
  <div class="grid">
    {%- for card_product in rail_products limit: rail_count %}
    {% render 'product-card', product: card_product, index: forloop.index, tone_index: forloop.index0, ratio: section.settings.card_ratio, hover: section.settings.card_hover, badge_mode: section.settings.card_badge, swatch_mode: section.settings.card_swatches, colour_mode: section.settings.card_colour %}
    {%- endfor %}
  </div>
{%- else %}
  {%- comment -%}
  Three tiers: a real Shopify collection, then cards added by hand here, then
  the shipped demo rail. The manual tier is what lets a card carry an image
  before the catalogue exists.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="grid">
  {%- for block in section.blocks -%}
    {%- assign i = forloop.index -%}
    {%- assign tone = '' -%}
    {%- assign mod = i | modulo: 4 -%}
    {%- if mod == 2 or mod == 0 -%}{%- assign tone = 'alt' -%}{%- endif -%}
    {%- if mod == 3 -%}{%- assign tone = 'dark' -%}{%- endif -%}
    <a class="card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-i="{{ i | prepend: '0' | slice: -2, 2 }}" {{ block.shopify_attributes }}>
      <div class="card-media">
        {%- if block.settings.image != blank -%}
          <img class="still" src="{{ block.settings.image | image_url: width: 800 }}" srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w" sizes="(max-width:700px) 50vw, 25vw" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" width="800" height="1000" loading="lazy">
        {%- else -%}
          <span class="ph {{ tone }} still"></span>
        {%- endif -%}
        {%- if block.settings.hover_image != blank -%}
          <img class="hover-img" src="{{ block.settings.hover_image | image_url: width: 800 }}" alt="" width="800" height="1000" loading="lazy">
        {%- endif -%}
        {%- if block.settings.badge != blank -%}<span class="card-badge">{{ block.settings.badge }}</span>{%- endif -%}
        <button class="card-fav" type="button" aria-label="Save {{ block.settings.title | escape }}" onclick="event.preventDefault();event.stopPropagation();this.classList.toggle('on')">
          <svg viewBox="0 0 24 24"><path d="M12 3.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L12 16.6 6.8 19.5 8 13.7 3.6 9.7l5.9-.7z"/></svg>
        </button>
      </div>
      <div class="card-info"><span class="card-name">{{ block.settings.title }}</span><span class="card-price">{{ block.settings.price }}</span></div>
      {%- if block.settings.colour != blank -%}
      <div class="card-sub"><span class="sw"></span><span class="card-colour">{{ block.settings.colour }}</span></div>
      {%- endif -%}
    </a>
  {%- endfor -%}
</div>
{%- else -%}
<div class="grid" data-{{ section.settings.rail }}=""></div>
{%- endif -%}
{%- endif %}
</section>
{%- endunless -%}
{% schema %}
{
  "name": "Product rail",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pick a collection to show real products. With no collection, any cards you add below are used instead \u2014 that is where you set images."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Straight off the line."
    },
    {
      "type": "textarea",
      "id": "body",
