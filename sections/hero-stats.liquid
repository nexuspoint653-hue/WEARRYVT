{% render 'section-style', s: section %}
{%- if section.settings.visible -%}
<style>
  #shopify-section-{{ section.id }} .hero-stack{position:relative;isolation:isolate}
  #shopify-section-{{ section.id }} .hero-stack > .plate{position:absolute;inset:0;z-index:0;pointer-events:none;
    {%- if section.settings.image != blank %}background-image:url({{ section.settings.image | image_url: width: 2400 }});background-size:cover;background-position:{{ section.settings.focal }};{% endif -%}
  }
  #shopify-section-{{ section.id }} .hero{background:transparent;position:relative;z-index:1}
  #shopify-section-{{ section.id }} .hero .plate{display:none}
  {%- if section.settings.show_stats %}
  #shopify-section-{{ section.id }} .stats{background:transparent;position:relative;z-index:1}
  #shopify-section-{{ section.id }} .stats-in{position:relative;z-index:1}
  {%- endif %}
</style>
<div class="hero-stack">
  <span class="plate{% if section.settings.image == blank %} ph {{ section.settings.plate_style }}{% endif %}"></span>
  {%- comment -%} The hero filter. Three stacked layers: an even tint for
  legibility, a shade under the header, and a fade that deepens to black at the
  bottom of the cards. Plain hex plus opacity, so nothing here can fail. {%- endcomment -%}
  <span class="hero-filter" aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none;background:{{ section.settings.tint_color }};opacity:{{ section.settings.tint_opacity }}%"></span>
  <span class="hero-filter" aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(to bottom,{{ section.settings.shade_color }} 0%,transparent {{ section.settings.shade_height }}px);opacity:{{ section.settings.shade_opacity }}%"></span>
  <span class="hero-filter" aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(to bottom,transparent calc(100% - {{ section.settings.fade_height }}px),{{ section.settings.fade_color }} 100%);opacity:{{ section.settings.fade_opacity }}%"></span>
<section class="hero">
  <div class="wrap hero-in">
    {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
    <div class="cta-row">
      {%- if section.settings.btn1_label != blank -%}<a class="btn btn-solid" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
      {%- if section.settings.btn2_label != blank -%}<a class="btn btn-ghost" href="{{ section.settings.btn2_link | default: '/pages/the-renaissance-tee' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
{%- if section.settings.show_stats -%}
<section class="stats">
  <div class="stats-in">
    {%- for block in section.blocks -%}
    <div class="stat" {{ block.shopify_attributes }}>
      <span class="stat-n num">{{ block.settings.figure }}</span>
      <span class="stat-l">{{ block.settings.label }}</span>
      {%- if block.settings.note != blank -%}<span class="stat-s">{{ block.settings.note }}</span>{%- endif -%}
    </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Hero + stat band",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Metro Detroit \u00b7 Est. 2024"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (line breaks kept)",
      "default": "Detroit,\nOn Your Back."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Heavyweight cotton cut for people who actually move. Made in small runs, finished by hand, and named for the streets it came from."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "plate_style",
      "label": "Placeholder tone (used when no image)",
      "default": "dark",
      "options": [
        {
          "value": "",
          "label": "Light"
        },
        {
          "value": "alt",
          "label": "Mid"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary label",
      "default": "One tee, four ways"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Image bleed"
    },
    {
      "type": "select",
      "id": "focal",
      "label": "Image position",
      "default": "center center",
      "options": [
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center center",
          "label": "Centre"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Stat band"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show the stat band",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero filter"
    },
    {
      "type": "paragraph",
      "content": "Three layers over the photo. The tint is even across the whole hero; the shade sits under the header; the fade deepens toward the bottom of the cards."
    },
    {
      "type": "color",
      "id": "tint_color",
      "label": "Tint colour",
      "default": "#0B0B0C"
    },
    {
      "type": "range",
      "id": "tint_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Tint strength",
      "default": 30,
      "info": "An even wash over the whole photo. This is what makes the hero copy readable."
    },
    {
      "type": "color",
      "id": "shade_color",
      "label": "Top shade colour",
      "default": "#0B0B0C"
    },
    {
      "type": "range",
      "id": "shade_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Top shade strength",
      "default": 35,
      "info": "Darkens the top edge so the header and nav stay legible."
    },
    {
      "type": "range",
      "id": "shade_height",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Top shade height",
      "default": 240
    },
    {
      "type": "color",
      "id": "fade_color",
      "label": "Bottom fade colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "fade_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bottom fade strength",
      "default": 92,
      "info": "How black it gets at the very bottom of the cards."
    },
    {
      "type": "range",
      "id": "fade_height",
      "min": 100,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Bottom fade height",
      "default": 620,
      "info": "How far up the fade starts. Larger begins higher in the photo and reads softer."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "figure",
          "label": "Figure",
          "default": "8.2 oz"
        },
        {
          "type": "text",
          "id": "label",
