    "ways": {
      "type": "story-ways",
      "settings": {},
      "blocks": {
        "ways_b1": {
          "type": "way",
          "settings": {
            "num": "01",
            "heading": "Worn open",
            "body": "Straight out of the bag, nothing done to it. The collar is ribbed and double-stitched so it keeps its round after the first wash instead of going wavy at the back of the neck.",
            "note": "Shown in Bone, size L on a 6'1\" frame.",
            "anchor_id": "way-1",
            "tone": ""
          }
        },
        "ways_b2": {
          "type": "way",
          "settings": {
            "num": "02",
            "heading": "Layered",
            "body": "Under a jacket the boxy cut matters: no sleeve bunching at the bicep, no hem riding up past the waistband when you reach. The shoulder seam sits where your shoulder ends.",
            "note": "Shown in Washed Black under the Foundry overshirt.",
            "anchor_id": "way-2",
            "tone": "alt"
          }
        },
        "ways_b3": {
          "type": "way",
          "settings": {
            "num": "03",
            "heading": "Tucked",
            "body": "Cut two inches longer than a standard body so a tuck holds through a full day rather than creeping out by lunch. The side seam is flat, so nothing bulks at the belt.",
            "note": "Shown in Bone with the Standard-Issue cargo.",
            "anchor_id": "way-3",
            "tone": "dark"
          }
        },
        "ways_b4": {
          "type": "way",
          "settings": {
            "num": "04",
            "heading": "Oversized",
            "body": "Size up once and the tee reads as outerwear without losing its shape at the hem. The heavier weight is what makes this work \u2014 a lighter knit would collapse.",
            "note": "Shown in Chalk, size XXL on the same 6'1\" frame.",
            "anchor_id": "way-4",
            "tone": ""
          }
        }
      },
      "block_order": [
        "ways_b1",
        "ways_b2",
        "ways_b3",
        "ways_b4"
      ]
    },
