        "doc_b6": {
          "type": "clause",
          "settings": {
            "title": "Intellectual property",
            "body": "<p>The RYVT name, the chevron mark, the product photography, the copy on this site and the garment designs are ours. You may share and link to our pages. You may not put our marks on your own goods, resell our images, or use our copy to sell competing product.</p>",
