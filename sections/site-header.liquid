      ]
    },
    {
      "type": "strip",
      "name": "Strip item",
      "settings": [
        {
          "type": "text",
          "id": "bold",
          "label": "Bold part",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Rest",
          "default": "over $125"
