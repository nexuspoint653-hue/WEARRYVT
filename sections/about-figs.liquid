{% render 'section-style', s: section %}
{%- unless section.settings.visible == false -%}
<section class="wrap br-figs">
  <dl>
    {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}><dt>{{ block.settings.term }}</dt><dd>{{ block.settings.value }}</dd></div>
    {%- endfor -%}
  </dl>
</section>
{%- endunless -%}
{% schema %}
{
  "name": "Brand figures",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Figure",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Term",
          "default": "Founded"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2024"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Brand figures",
      "blocks": [
        {
          "type": "figure",
          "settings": {
            "term": "Founded",
            "value": "2024"
          }
        },
        {
          "type": "figure",
          "settings": {
            "term": "Styles",
            "value": "8"
          }
        },
        {
          "type": "figure",
          "settings": {
            "term": "Cloth",
            "value": "8.2 oz"
          }
        },
        {
          "type": "figure",
          "settings": {
            "term": "Dispatch",
            "value": "48h"
          }
        },
        {
          "type": "figure",
          "settings": {
            "term": "Returns",
            "value": "30 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
