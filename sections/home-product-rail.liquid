{% render 'section-style', s: section %}
{%- if section.settings.visible -%}
{%- comment -%}
    Real products when the merchant has pointed this rail at a collection.
    Nothing picked, or nothing in it, and the original JS-driven container is
    rendered instead - untouched, data hook and all - so the demo rail still
    paints itself exactly as it does today.
{%- endcomment -%}
{%- liquid
  assign rail_coll = collections[section.settings.collection]
  assign rail_products = rail_coll.products
  assign rail_size = rail_products.size | plus: 0
  assign rail_count = section.settings.count | default: 4 | plus: 0
  assign has_products = false
  if rail_size > 0 and rail_count > 0
    assign has_products = true
  endif
  assign gcols = section.settings.columns | default: 'default'
  assign gcols_n = gcols | plus: 0
  assign gcols_m = gcols_n
  if gcols_m > 3
    assign gcols_m = 3
  endif
  assign gcols_s = gcols_n
  if gcols_s > 2
    assign gcols_s = 2
  endif
-%}
<section class="sec wrap"{% if section.settings.tight %} style="padding-top:0"{% endif %}>
  <div class="sec-h">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 style="margin-top:8px">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- if section.settings.more_label != blank -%}
    <a class="more" href="{{ section.settings.more_link | default: routes.all_products_collection_url }}">{{ section.settings.more_label }}</a>
    {%- endif -%}
  </div>
{%- if has_products %}
{%- if gcols != 'default' %}
  <style>#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_n }},1fr)}@media(max-width:1000px){#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_m }},1fr)}}@media(max-width:749px){#shopify-section-{{ section.id }} .grid{grid-template-columns:repeat({{ gcols_s }},1fr)}}</style>
{%- endif %}
  <div class="grid">
    {%- for card_product in rail_products limit: rail_count %}
    {% render 'product-card', product: card_product, index: forloop.index, tone_index: forloop.index0, ratio: section.settings.card_ratio, hover: section.settings.card_hover, badge_mode: section.settings.card_badge, swatch_mode: section.settings.card_swatches, colour_mode: section.settings.card_colour %}
    {%- endfor %}
  </div>
{%- else %}
  <div class="grid" data-{{ section.settings.rail }}=""></div>
{%- endif %}
</section>
{%- endif -%}

