      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Featured card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
