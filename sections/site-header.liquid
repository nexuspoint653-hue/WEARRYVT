        },
        {
          "type": "select",
          "id": "tone",
          "label": "Placeholder tone",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Light"
            },
            {
              "value": "alt",
              "label": "Mid"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ]
        },
