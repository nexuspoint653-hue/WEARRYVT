{% render 'section-style', s: section %}
{%- if section.settings.visible -%}
{%- assign pfx = section.settings.anchor_prefix | default: 'doc' -%}
<div class="doc-hd">
<div class="wrap">
{%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
{%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading | newline_to_br }}</h1>{%- endif -%}
{%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
{%- if section.settings.meta1 != blank or section.settings.meta2 != blank or section.settings.meta3 != blank -%}
<div class="doc-meta">{%- if section.settings.meta1 != blank -%}<span>{{ section.settings.meta1 }}</span>{%- endif -%}{%- if section.settings.meta2 != blank -%}<span>{{ section.settings.meta2 }}</span>{%- endif -%}{%- if section.settings.meta3 != blank -%}<span>{{ section.settings.meta3 }}</span>{%- endif -%}</div>
{%- endif -%}
</div>
</div><div class="wrap doc">
{%- if section.blocks.size > 0 -%}
<aside class="doc-nav">
{%- if section.settings.nav_title != blank -%}<h4>{{ section.settings.nav_title }}</h4>{%- endif -%}
<ol>
{%- for block in section.blocks -%}
<li><a href="#{{ pfx }}-{{ forloop.index }}">{{ block.settings.title }}</a></li>
{%- endfor -%}
</ol>
</aside>
{%- endif -%}
<div class="doc-body">
{%- for block in section.blocks -%}
{%- assign n = forloop.index | prepend: '0' | slice: -2, 2 -%}
<section id="{{ pfx }}-{{ forloop.index }}" {{ block.shopify_attributes }}>
<h2><span>{{ n }}</span>{{ block.settings.title }}</h2>
{%- if block.settings.table != blank and block.settings.table_first -%}
{{ block.settings.table }}
{%- endif -%}
{%- if block.settings.body != blank -%}
{{ block.settings.body }}
{%- endif -%}
{%- if block.settings.table != blank and block.settings.table_first == false -%}
{{ block.settings.table }}
{%- endif -%}
</section>
{%- endfor -%}
</div>
</div>
{%- endif -%}

{% schema %}
{
