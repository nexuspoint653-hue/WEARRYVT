
<div class="stage" data-stage>
  <video data-film autoplay muted loop playsinline preload="auto" poster="{{ 'ryvt-landing-29e16db41a.png' | asset_url }}">
    <source src="" type="video/webm">
    <source src="" type="video/mp4">
  </video>
</div>
<div class="grain" aria-hidden="true"></div>

<div class="promo" data-promo>
  <div class="promo-in">
    <span class="promo-dot" aria-hidden="true"></span>
    <span class="promo-track" data-promo-track aria-live="polite">
      <span class="promo-msg on">New drop is live &mdash; small run, built in Metro Detroit</span>
      <span class="promo-msg">Free shipping on every order over $125</span>
      <span class="promo-msg">Sign up and take 10% off your first order</span>
    </span>
    <a class="promo-cta" href="/pages/store?view=shop">Shop the drop</a>
    <button class="promo-x" type="button" data-promo-close aria-label="Dismiss">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
</div>

<main class="core">
  <div class="core-in">
    <div class="mark">
      <span class="orb" aria-hidden="true"></span>
      <img class="logo" src="{{ 'ryvt-landing-bc1a5b33d5.png' | asset_url }}" alt="RYVT" width="320" height="66">
    </div>

    <nav class="menu" aria-label="Main">
      <a href="/pages/store?view=shop">Shop</a>
      <a href="/pages/store?view=shop">New Arrivals</a>
      <a href="/pages/store?view=story">The Renaissance Tee</a>
      <a href="/pages/store?view=about">Detroit</a>
      <a href="/pages/store?view=contact">Contact</a>
    </nav>
  </div>
</main>

<div class="hud hud-bc">
  <div class="clock"><b data-city>DETROIT</b><span data-time>--:--:--</span></div>
</div>

<div class="hud-row">
  <div class="hud hud-bl">
    <div class="np" data-np>
      <span class="np-art" aria-hidden="true"></span>
      <span class="np-t">
        <b>Now playing</b>
        <span>The RYVT mix</span>
        <span class="np-chip">Preview</span>
      </span>
      <span class="np-ctl">
        <button type="button" aria-label="Save track">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
        </button>
        <button type="button" aria-label="More">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
            <circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
        </button>
        <button type="button" class="np-play" data-np-toggle aria-label="Play preview">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" data-np-icon>
            <path d="M8 5l11 7-11 7z"/></svg>
        </button>
      </span>
    </div>
  </div>

  <div class="hud hud-br">
    <a class="buy" href="/pages/store?view=shop">
      <span class="buy-m" aria-hidden="true" data-slides>
          <img src="{{ 'ryvt-landing-28b3195b55.jpg' | asset_url }}" alt="" class="on">
          <img src="{{ 'ryvt-landing-0cfd1c205a.jpg' | asset_url }}" alt="">
          <img src="{{ 'ryvt-landing-0abe04c485.jpg' | asset_url }}" alt="">
          <img src="{{ 'ryvt-landing-9ccfddc7d4.jpg' | asset_url }}" alt="">
        </span>
      <span class="buy-t">
        <b>New Drops</b>
        <span>Heavyweight release <i>8 styles</i></span>
      </span>
      <span class="buy-go" aria-hidden="true">&rarr;</span>
    </a>
    <a class="ship" href="/pages/store?view=shipping">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg>
      Free shipping over <b>$125</b>
    </a>
  </div>
</div>

<div class="bar" data-bar>
  <a class="bar-mark" href="/pages/store"><img src="{{ 'ryvt-landing-bc1a5b33d5.png' | asset_url }}" alt="RYVT"></a>
  <nav class="bar-nav">
    <a href="/pages/store?view=shop">Shop</a><a href="/pages/store?view=shop">New Arrivals</a><a href="/pages/store?view=story">The Renaissance Tee</a><a href="/pages/store?view=about">Detroit</a>
  </nav>
  <a class="bar-cart" href="/pages/store?view=shop">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M4 7h16l-1.2 13H5.2z"/><path d="M8.6 9V6.4a3.4 3.4 0 0 1 6.8 0V9"/></svg>
    Bag (0)
  </a>
</div>

<div class="lp-scroll" aria-hidden="true"><span>Scroll</span><i></i></div>

<div class="lp-spacer" aria-hidden="true"></div>

<footer class="lp-ft">
  <div class="lp-ft-in">
    <form class="lp-sub" data-sub>
      <label for="lp-email">Subscribe to our newsletter</label>
      <div class="lp-sub-row">
        <input id="lp-email" type="email" placeholder="Your email" required>
        <button type="submit">Join</button>
      </div>
      <p>First look at every drop, an hour before it lists. One email a fortnight, no more.</p>
    </form>

    <div class="lp-cols">
      <div>
        <h4>Customer care</h4>
        <ul>
          <li><a href="/pages/store?view=contact">Account</a></li>
          <li><a href="/pages/store?view=about">Our store</a></li>
          <li><a href="/pages/store?view=faq">FAQ</a></li>
          <li><a href="/pages/store?view=shipping">Shipping &amp; returns</a></li>
        </ul>
      </div>
      <div>
        <h4>Shop</h4>
        <ul>
          <li><a href="/pages/store?view=shop">All styles</a></li>
          <li><a href="/pages/store?view=shop&amp;filter=Tees">Heavyweight tees</a></li>
          <li><a href="/pages/store?view=shop&amp;filter=Tanks">Tank tops</a></li>
          <li><a href="/pages/store?view=shop&amp;filter=Bottoms">Cargo &amp; shorts</a></li>
        </ul>
      </div>
      <div>
        <h4>Brand</h4>
        <ul>
          <li><a href="/pages/store?view=about">About RYVT</a></li>
          <li><a href="/pages/store?view=story">The Renaissance Tee</a></li>
          <li><a href="/pages/store?view=about">Made in Detroit</a></li>
          <li><a href="/pages/store?view=contact">Wholesale</a></li>
        </ul>
      </div>
      <div>
        <h4>Journal</h4>
        <ul>
          <li><a href="/pages/store?view=story">One tee, four ways</a></li>
          <li><a href="/pages/store?view=faq">Why we wash first</a></li>
          <li><a href="/pages/store?view=faq">The fourth-year test</a></li>
          <li><a href="/pages/store?view=contact">Press</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="lp-ft-btm">
    <span>&copy; 2026 RYVT &middot; Metro Detroit, Michigan</span>
    <nav>
      <a href="/pages/store?view=terms">Terms</a>
      <a href="/pages/store?view=privacy">Privacy</a>
      <a href="/pages/store?view=social">Social media disclaimer</a>
    </nav>
    <span>Instagram &middot; TikTok</span>
  </div>
</footer>

<div class="cur off" data-cur aria-hidden="true"></div>
<div class="cur-r off" data-cur-ring aria-hidden="true"></div>

<script src="{{ 'ryvt-film.js' | asset_url }}" defer></script>
<script src="{{ 'ryvt-landing.js' | asset_url }}" defer></script>

