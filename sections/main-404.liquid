{% render 'section-style', s: section %}
{%- unless section.settings.visible == false -%}
<div class="doc-hd">
<div class="wrap">
{%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
{%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading | newline_to_br }}</h1>{%- endif -%}
{%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
{%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
<div class="doc-cta">
{%- if section.settings.btn1_label != blank -%}
<a class="btn btn-dark" data-go="shop" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>
{%- endif -%}
{%- if section.settings.btn2_label != blank -%}
<a class="btn" data-go="contact" href="{{ section.settings.btn2_link | default: '/pages/contact' }}" style="border:1px solid var(--line)">{{ section.settings.btn2_label }}</a>
{%- endif -%}
</div>
{%- endif -%}
</div>
</div>
{%- endunless -%}
{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "404"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (line breaks kept)",
      "default": "That page has been restocked out of existence."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The link is dead, but the run is not. Start from the collection, or ask us where it went."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary label",
      "default": "Shop all styles"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "404 page"
    }
  ]
}
{% endschema %}
