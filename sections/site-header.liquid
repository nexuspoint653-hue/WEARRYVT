      "default": "4 styles"
    },
    {
      "type": "text",
      "id": "sugg_heading",
      "label": "Suggestions heading",
      "default": "Popular right now"
    },
    {
      "type": "text",
      "id": "jump_heading",
      "label": "Jump-to heading",
      "default": "Jump to"
    },
    {
      "type": "link_list",
      "id": "jump_menu",
      "label": "Jump-to menu",
      "info": "Empty = the designed Jump to list."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
