{% render 'section-style', s: section %}
{%- if section.settings.visible -%}
<section class="sec wrap">
  <div class="sec-h">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 style="margin-top:8px">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- if section.settings.more_label != blank -%}
    <a class="more" href="{{ section.settings.more_link | default: routes.all_products_collection_url }}">{{ section.settings.more_label }}</a>
    {%- endif -%}
  </div>
  <div class="cats">
    {%- for block in section.blocks -%}
    <a class="cat" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
      <span class="fig">
        {%- if block.settings.image != blank -%}
        <span class="ph" style="background-image:url({{ block.settings.image | image_url: width: 900 }});background-size:cover;background-position:center"></span>
        {%- else -%}
        <span class="ph {{ block.settings.tone }}"></span>
        {%- endif -%}
      </span>
      <span class="cat-lab"><span><b>{{ block.settings.title }}</b><span>{{ block.settings.count }}</span></span>
      <span class="cat-go">→</span></span>
    </a>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Category row",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four categories, one fit standard."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Link label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "more_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_override",
      "label": "Override spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Heavyweight Tees"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Sub-label",
          "default": "4 styles"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Placeholder tone",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Light"
            },
            {
              "value": "alt",
              "label": "Mid"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Category row",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Heavyweight Tees",
            "count": "4 styles",
            "tone": ""
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Tank Tops",
            "count": "2 styles",
            "tone": "alt"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Cargo & Shorts",
            "count": "2 styles",
            "tone": "dark"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Shop All",
            "count": "8 styles",
            "tone": "alt"
          }
        }
      ]
    }
  ]
}
{% endschema %}
