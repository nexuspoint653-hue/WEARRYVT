      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Heading size (0 = theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size (0 = theme default)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "promo_msg",
      "name": "Promo message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "New drop is live &mdash; small run, built in Metro Detroit"
        }
      ]
    },
    {
      "type": "nav_link",
      "name": "Menu link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "bar_link",
      "name": "Sticky bar link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Card slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "foot_col",
      "name": "Footer column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Customer care"
        },
        {
          "type": "text",
          "id": "l1_label",
          "label": "Link 1 label",
          "default": "Account"
        },
        {
          "type": "url",
          "id": "l1_link",
          "label": "Link 1"
        },
        {
          "type": "text",
          "id": "l2_label",
          "label": "Link 2 label",
          "default": "Our store"
        },
        {
          "type": "url",
          "id": "l2_link",
          "label": "Link 2"
        },
        {
          "type": "text",
          "id": "l3_label",
          "label": "Link 3 label",
          "default": "FAQ"
        },
        {
