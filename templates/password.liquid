<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0B0B0C;color:#fff;font-family:Inter,system-ui,sans-serif">
  <div style="text-align:center;max-width:420px;padding:32px">
    <h1 style="letter-spacing:.3em;font-size:20px;margin:0 0 24px">RYVT</h1>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" style="width:100%;padding:12px;margin-bottom:12px;background:#151517;border:1px solid #2a2a2e;color:#fff">
      <button type="submit" style="width:100%;padding:12px;background:#fff;color:#0B0B0C;border:0;cursor:pointer">Enter</button>
    {% endform %}
  </div>
</div>
